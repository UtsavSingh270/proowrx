# Public URL (this value is included in browser bundles and metadata)
NEXT_PUBLIC_SITE_URL=https://proowrx.com

# Server-only secrets
NODE_ENV=production
MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/DATABASE
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=8h
ADMIN_USERNAME=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password-of-14-or-more-characters
TRUST_PROXY=1
DNS_SERVERS=

# Email delivery
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Proowrx <no-reply@example.com>
EMAIL_TO=
SUPPORT_EMAIL=
MEETING_CC_1=
MEETING_CC_2=
MEETING_CC_3=

# Cloudinary uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=proowrx_media
